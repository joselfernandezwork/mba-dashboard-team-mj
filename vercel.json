{
  "version": 2,
  "builds": [
    {
      "src": ".",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/data/(.*).json",
      "headers": {
        "Cache-Control": "s-maxage=3600, stale-while-revalidate"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
